<!DOCTYPE html>
<html lang="en">

<head>

<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">

<title>TRAVELX | Packages</title>

<style>

*{
    margin:0;
    padding:0;
    box-sizing:border-box;
}

body{
    font-family:Arial,sans-serif;
    background:#f5f8fa;
    color:#172026;
}

/* NAVBAR */

.navbar{
    background:#0f172a;

    display:flex;
    justify-content:space-between;
    align-items:center;

    padding:22px 7%;
}

.logo{
    color:white;
    font-size:28px;
    font-weight:900;
    letter-spacing:4px;
}

.nav-links{
    display:flex;
    gap:22px;
}

.nav-links a{
    color:white;
    text-decoration:none;
    font-size:15px;
    transition:.3s;
}

.nav-links a:hover{
    color:#67e8f9;
}


/* HEADER */

.header{
    text-align:center;

    padding:80px 20px;

    background:
        linear-gradient(
            135deg,
            #0f766e,
            #164e63
        );

    color:white;
}

.header h1{
    font-size:50px;
    margin-bottom:15px;
}

.header p{
    font-size:18px;
    color:#dff7f5;
}


/* PACKAGES */

.packages{
    max-width:1100px;

    margin:auto;

    padding:70px 20px;

    display:grid;

    grid-template-columns:
        repeat(3,1fr);

    gap:25px;
}


/* CARD */

.package-card{
    background:white;

    border-radius:20px;

    padding:30px;

    text-align:center;

    box-shadow:
        0 8px 25px rgba(0,0,0,.08);

    transition:.3s;
}

.package-card:hover{
    transform:translateY(-10px);

    box-shadow:
        0 15px 35px rgba(0,0,0,.14);
}

.package-icon{
    font-size:55px;

    margin-bottom:15px;
}

.package-card h2{
    margin-bottom:12px;
}

.package-card p{
    color:#667780;

    line-height:1.7;

    font-size:14px;
}


/* PRICE */

.price{
    font-size:30px;

    font-weight:bold;

    margin:22px 0;

    color:#0f766e;
}

.price span{
    font-size:14px;

    color:#718096;

    font-weight:normal;
}


/* FEATURES */

.package-card ul{
    list-style:none;

    text-align:left;

    margin:20px 0;
}

.package-card li{
    padding:9px 0;

    border-bottom:1px solid #edf2f7;

    color:#53656d;

    font-size:14px;
}

.package-card li:last-child{
    border-bottom:none;
}


/* BUTTON */

.btn{
    display:inline-block;

    margin-top:15px;

    padding:12px 25px;

    background:#0f766e;

    color:white;

    text-decoration:none;

    border-radius:25px;

    transition:.3s;
}

.btn:hover{
    background:#115e59;

    transform:translateY(-3px);
}


/* INFO */

.info{
    max-width:900px;

    margin:0 auto 70px;

    padding:35px 25px;

    background:#e6f7f5;

    border-radius:20px;

    text-align:center;
}

.info h2{
    margin-bottom:12px;
}

.info p{
    color:#53656d;

    line-height:1.7;
}


/* FOOTER */

footer{
    padding:25px;

    background:#0f172a;

    color:#aebcc2;

    text-align:center;

    font-size:14px;
}


/* MOBILE */

@media(max-width:850px){

    .navbar{
        flex-direction:column;

        gap:18px;
    }

    .nav-links{
        flex-wrap:wrap;

        justify-content:center;
    }

    .header h1{
        font-size:40px;
    }

    .packages{
        grid-template-columns:1fr;
    }

}

</style>

</head>


