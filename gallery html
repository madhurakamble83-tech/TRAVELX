 <!DOCTYPE html>
<html lang="en">

<head>

<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">

<title>TRAVELX | Gallery</title>

<style>

*{
    margin:0;
    padding:0;
    box-sizing:border-box;
}

body{
    font-family:Arial,sans-serif;
    background:#f5f8fa;
    color:#172026;
}

/* NAVBAR */

.navbar{
    background:#0f172a;

    display:flex;
    justify-content:space-between;
    align-items:center;

    padding:22px 7%;
}

.logo{
    color:white;
    font-size:28px;
    font-weight:900;
    letter-spacing:4px;
}

.nav-links{
    display:flex;
    gap:22px;
}

.nav-links a{
    color:white;
    text-decoration:none;
    font-size:15px;
    transition:.3s;
}

.nav-links a:hover{
    color:#67e8f9;
}


/* HEADER */

.header{
    text-align:center;

    padding:80px 20px;

    background:
        linear-gradient(
            135deg,
            #164e63,
            #0f766e
        );

    color:white;
}

.header h1{
    font-size:50px;
    margin-bottom:15px;
}

.header p{
    font-size:18px;
    color:#dff7f5;
}


/* GALLERY */

.gallery{
    max-width:1100px;

    margin:auto;

    padding:70px 20px;

    display:grid;

    grid-template-columns:
        repeat(3,1fr);

    gap:22px;
}


/* GALLERY CARD */

.photo{
    min-height:250px;

    border-radius:20px;

    display:flex;

    align-items:center;

    justify-content:center;

    flex-direction:column;

    text-align:center;

    color:white;

    overflow:hidden;

    position:relative;

    box-shadow:
        0 8px 25px rgba(0,0,0,.10);

    transition:.3s;
}

.photo:hover{
    transform:translateY(-8px);

    box-shadow:
        0 15px 35px rgba(0,0,0,.16);
}

.photo-icon{
    font-size:70px;

    margin-bottom:15px;
}

.photo h2{
    font-size:25px;
}

.photo p{
    margin-top:8px;

    font-size:14px;

    color:#f1f5f9;
}


/* DIFFERENT CARDS */

.goа{
    background:
        linear-gradient(
            135deg,
            #0891b2,
            #0f766e
        );
}

.manali{
    background:
        linear-gradient(
            135deg,
            #2563eb,
            #172554
        );
}

.jaipur{
    background:
        linear-gradient(
            135deg,
            #db2777,
            #7c2d12
        );
}

.kerala{
    background:
        linear-gradient(
            135deg,
            #059669,
            #064e3b
        );
}

.kashmir{
    background:
        linear-gradient(
            135deg,
            #38bdf8,
            #1e3a8a
        );
}

.mumbai{
    background:
        linear-gradient(
            135deg,
            #7c3aed,
            #312e81
        );
}


/* GALLERY INFO */

.gallery-info{
    max-width:900px;

    margin:0 auto 70px;

    padding:35px 25px;

    background:#e6f7f5;

    border-radius:20px;

    text-align:center;
}

.gallery-info h2{
    margin-bottom:12px;
}

.gallery-info p{
    color:#53656d;

    line-height:1.7;
}


/* FOOTER */

footer{
    padding:25px;

    background:#0f172a;

    color:#aebcc2;

    text-align:center;

    font-size:14px;
}


/* MOBILE */

@media(max-width:850px){

    .navbar{
        flex-direction:column;

        gap:18px;
    }

    .nav-links{
        flex-wrap:wrap;

        justify-content:center;
    }

    .header h1{
        font-size:40px;
    }

    .gallery{
        grid-template-columns:1fr;
    }

}

</style>

</head>


<body>


<!-- NAVBAR -->

<nav class="navbar">

    <div class="logo">
        TRAVELX
    </div>

    <div class="nav-links">

        <a href="index.html">
            Home
        </a>

        <a href="destinations.html">
            Destinations
        </a>

        <a href="packages.html">
            Packages
        </a>

        <a href="gallery.html">
            Gallery
        </a>

        <a href="about.html">
            About
        </a>

    </div>

</nav>


<!-- HEADER -->

<section class="header">

    <h1>
        Travel Gallery
    </h1>

    <p>
        Explore beautiful destinations and
        memorable travel experiences.
    </p>

</section>


<!-- GALLERY -->

<section class="gallery">


    <div class="photo goа">

        <div class="photo-icon">
            🏖️
        </div>

        <h2>
            Goa
        </h2>

        <p>
            Beaches & Sunsets
        </p>

    </div>


    <div class="photo manali">

        <div class="photo-icon">
            🏔️
        </div>

        <h2>
            Manali
        </h2>

        <p>
            Mountains & Adventure
        </p>

    </div>


    <div class="photo jaipur">

        <div class="photo-icon">
            🕌
        </div>

        <h2>
            Jaipur
        </h2>

        <p>
            Royal Heritage
        </p>

    </div>


    <div class="photo kerala">

        <div class="photo-icon">
            🌴
        </div>

        <h2>
            Kerala
        </h2>

        <p>
            Backwaters & Nature
        </p>

    </div>


    <div class="photo kashmir">

        <div class="photo-icon">
            ❄️
        </div>

        <h2>
            Kashmir
        </h2>

        <p>
            Valleys & Snow
        </p>

    </div>


    <div class="photo mumbai">

        <div class="photo-icon">
            🌆
        </div>

        <h2>
            Mumbai
        </h2>

        <p>
            City Life & Landmarks
        </p>

    </div>

</section>


<!-- INFO -->

<section class="gallery-info">

    <h2>
        Capture Your Journey
    </h2>

    <p>
        Every destination has a story to tell.
        Explore new places, experience different
        cultures and create unforgettable memories
        with TRAVELX.
    </p>

</section>


<!-- FOOTER -->

<footer>

    © 2026 TRAVELX — Explore • Travel • Discover

</footer>


</body>

</html>
